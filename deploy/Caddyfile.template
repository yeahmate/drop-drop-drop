# Drop Drop Drop. Generated by deploy/install.sh; edit the template in the
# repository rather than this file, or the next install will overwrite it.
{
	email __EMAIL__
}

__DOMAIN__ {
	root * __WEB_ROOT__/current
	encode zstd gzip
	file_server

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# The app needs the phone's GPS and nothing else.
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
		-Server
	}

	# Hashed build files never change, so phones may keep them for a year.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# The page, service worker and manifest must be re-checked every visit or
	# installed copies never notice an update.
	@fresh path / /index.html /sw.js /registerSW.js /manifest.webmanifest /workbox-*.js
	header @fresh Cache-Control "no-cache"

	log {
		output file __ACCESS_LOG__ {
			roll_size 10mb
			roll_keep 5
		}
	}
}
